{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "query",
      "title": "Tree-sitter Query",
      "scope": "source.query",
      "path": ".",
      "file-types": ["scm"],
      "injection-regex": "^query$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Tree-sitter Query.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-query"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
